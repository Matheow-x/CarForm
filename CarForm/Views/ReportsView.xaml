<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CarForm.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarForm.Views"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <views:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
        <views:EnumDisplayConverter x:Key="EnumDisplay" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardFlat}" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="بروزرسانی" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="پاک کردن فیلترها" Command="{Binding ResetCommand}" Margin="8,0,0,0" />
                <Button Content="خروجی CSV" Command="{Binding ExportCsvCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding ResultCount, StringFormat=تعداد نتایج: {0}}"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="موجودیت" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding EntityTypes}" SelectedItem="{Binding EntityTypeFilter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="نوع عملیات" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding ActionFilter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="جستجو در متن" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="از تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FromDateJalali, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="امروز" Command="{Binding SetTodayFromCommand}" Style="{StaticResource GhostButton}" />
                    </Grid>
                    <TextBlock Text="{Binding [FromDateJalali]}" Style="{StaticResource FieldError}"
                               Visibility="{Binding [FromDateJalali], Converter={StaticResource EmptyToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <TextBlock Text="تا تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ToDateJalali, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="امروز" Command="{Binding SetTodayToCommand}" Style="{StaticResource GhostButton}" />
                    </Grid>
                    <TextBlock Text="{Binding [ToDateJalali]}" Style="{StaticResource FieldError}"
                               Visibility="{Binding [ToDateJalali], Converter={StaticResource EmptyToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" Style="{StaticResource ModernDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="زمان (شمسی)" Binding="{Binding JalaliTimestamp}" Width="160" />
                <DataGridTextColumn Header="موجودیت" Binding="{Binding EntityTypeName}" Width="160" />
                <DataGridTextColumn Header="عملیات" Binding="{Binding ActionName}" Width="100" />
                <DataGridTextColumn Header="خلاصه" Binding="{Binding Summary}" Width="*" />
                <DataGridTextColumn Header="شناسه" Binding="{Binding EntityId}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
