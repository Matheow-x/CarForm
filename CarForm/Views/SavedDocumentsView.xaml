<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CarForm.Views.SavedDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarForm.Views"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <views:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardFlat}" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="سند جدید" Command="{Binding NewDocumentCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="ویرایش" Command="{Binding EditCommand}" Margin="8,0,0,0" />
                <Button Content="پیش‌نمایش" Command="{Binding PreviewCommand}" Margin="8,0,0,0" />
                <Button Content="چاپ" Command="{Binding PrintCommand}" Margin="8,0,0,0" />
                <Button Content="خروجی PDF" Command="{Binding ExportPdfCommand}" Margin="8,0,0,0" />
                <Button Content="حذف" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
            </WrapPanel>
        </Border>

        <!-- filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                    <TextBlock Text="شماره سند" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NumberFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                    <TextBlock Text="نام خریدار" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding BuyerFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,8">
                    <TextBlock Text="برند / مدل / پلاک" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding VehicleFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="6" Margin="0,0,0,8">
                    <TextBlock Text="VIN / شماره موتور / شاسی" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding VinFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="از تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FromDateJalali, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="امروز" Command="{Binding SetTodayFromCommand}" Style="{StaticResource GhostButton}" />
                    </Grid>
                    <TextBlock Text="{Binding [FromDateJalali]}" Style="{StaticResource FieldError}"
                               Visibility="{Binding [FromDateJalali], Converter={StaticResource EmptyToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="تا تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ToDateJalali, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="امروز" Command="{Binding SetTodayToCommand}" Style="{StaticResource GhostButton}" />
                    </Grid>
                    <TextBlock Text="{Binding [ToDateJalali]}" Style="{StaticResource FieldError}"
                               Visibility="{Binding [ToDateJalali], Converter={StaticResource EmptyToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Grid.ColumnSpan="3">
                    <Button Content="جستجو" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="پاک کردن فیلترها" Command="{Binding ResetCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="بروزرسانی" Command="{Binding SearchCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- grid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding SelectedDocument}"
                  Style="{StaticResource ModernDataGrid}">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="شماره سند" Binding="{Binding DocumentNumber}" Width="130" />
                <DataGridTextColumn Header="تاریخ (شمسی)" Binding="{Binding JalaliDocumentDate}" Width="120" />
                <DataGridTextColumn Header="خریدار" Binding="{Binding BuyerName}" Width="*" />
                <DataGridTextColumn Header="خودرو" Binding="{Binding VehicleTitle}" Width="220" />
                <DataGridTextColumn Header="VIN" Binding="{Binding VehicleVin}" Width="180" />
                <DataGridTextColumn Header="جمع کل (ریال)" Binding="{Binding TotalAmount, StringFormat=N0}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
