<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CarForm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CarForm.ViewModels"
        xmlns:views="clr-namespace:CarForm.Views"
        Title="CarForm - مدیریت اسناد فروش خودرو"
        Height="840" Width="1360"
        MinHeight="660" MinWidth="1080"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate DataType="{x:Type vm:NewDocumentWizardViewModel}">
            <views:NewDocumentWizardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SavedDocumentsViewModel}">
            <views:SavedDocumentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VehiclesViewModel}">
            <views:VehiclesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OwnersViewModel}">
            <views:OwnersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompanySettingsViewModel}">
            <views:CompanySettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentSettingsViewModel}">
            <views:DocumentSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppSettingsViewModel}">
            <views:AppSettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,22,18,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SidebarAccentBrush}">
                            <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CarForm" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="اسناد فروش خودرو" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource SidebarTextBrush}"
                         Margin="10,0,10,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,9" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
                            <Setter Property="FontSize" Value="13.5" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarAccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           VerticalAlignment="Center" Width="24" TextAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Padding="16,12" Background="#10FFFFFF">
                    <StackPanel>
                        <TextBlock Text="{Binding TodayJalali, StringFormat=امروز: {0}}"
                                   Foreground="{DynamicResource SidebarTextBrush}" FontSize="12" />
                        <TextBlock Text="نسخه ۱.۰.۰ - حالت آفلاین"
                                   Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" Opacity="0.7" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="22,14">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
            </Border>

            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentPage}" Margin="18" />
            </Grid>
        </Grid>
    </Grid>
</Window>
