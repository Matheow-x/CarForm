<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CarForm.Views.CompanySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarForm.Views"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <views:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="اطلاعات شرکت (فروشنده)" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="این اطلاعات به عنوان صادرکننده در تمام اسناد چاپ می‌شود."
                               Style="{StaticResource MutedText}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <TextBlock Text="نام شرکت" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding [Name]}" Style="{StaticResource FieldError}"
                                       Visibility="{Binding [Name], Converter={StaticResource EmptyToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                            <TextBlock Text="تلفن" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company.Phone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="کد پستی" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company.PostalCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="کد اقتصادی" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company.EconomicCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                            <TextBlock Text="شناسه ملی" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company.NationalId, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,0,10">
                            <TextBlock Text="نشانی" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company.Address, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="شماره دستورالعمل کاردکس" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company.KardexInstructionNo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="شماره دستورالعمل شماره‌گذاری" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company.NumberingInstructionNo, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="4" Margin="0,0,0,10">
                            <TextBlock Text="شماره پرونده مالیاتی" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Company.TaxFileNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="لوگوی شرکت" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="150" Height="150" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Background="{DynamicResource GridHeaderBrush}" Padding="6">
                            <Image Source="{Binding Logo}" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <Button Content="انتخاب تصویر لوگو" Command="{Binding PickLogoCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="حذف لوگو" Command="{Binding ClearLogoCommand}" Margin="0,8,0,0" />
                            <TextBlock Text="تصویر به طور خودکار تغییر اندازه و فشرده می‌شود تا در چاپ مشکلی ایجاد نکند."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Width="320" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="ذخیره اطلاعات شرکت" Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}" />
                <Button Content="بازخوانی" Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
