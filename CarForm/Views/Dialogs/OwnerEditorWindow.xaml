<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CarForm.Views.Dialogs.OwnerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CarForm.Views"
        Title="{Binding Title}"
        Width="700" SizeToContent="Height"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <views:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- type -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="نوع مالک" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="شخص حقیقی" IsChecked="{Binding IsIndividual}" GroupName="OwnerTypeGroup" />
                    <RadioButton Content="شخص حقوقی" IsChecked="{Binding IsLegalEntity}" GroupName="OwnerTypeGroup" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- fields -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <!-- individual -->
                    <StackPanel Visibility="{Binding IsIndividual, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="مشخصات شخص حقیقی" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="نام" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.FirstName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding [FirstName]}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding [FirstName], Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="نام خانوادگی" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.LastName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding [LastName]}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding [LastName], Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="نام پدر" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.FatherName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="کد ملی" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.NationalCode, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding [NationalCode]}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding [NationalCode], Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="شماره شناسنامه" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.IdNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="تاریخ تولد (شمسی)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding BirthDateJalali, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding [BirthDateJalali]}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding [BirthDateJalali], Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <TextBlock Text="محل تولد" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.BirthPlace, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <TextBlock Text="تاریخ صدور (شمسی)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding IssueDateJalali, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding [IssueDateJalali]}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding [IssueDateJalali], Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="محل صدور / ثبت" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.IssuePlace, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- legal entity -->
                    <StackPanel Visibility="{Binding IsLegalEntity, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="مشخصات شخص حقوقی" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                <TextBlock Text="نام شرکت" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding [CompanyName]}" Style="{StaticResource FieldError}"
                                           Visibility="{Binding [CompanyName], Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="شناسه ملی" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.CompanyNationalId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="کد اقتصادی" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.EconomicCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                                <TextBlock Text="شماره ثبت" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.RegistrationNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Text="نام نماینده" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.RepresentativeName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="کد ملی نماینده" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Owner.RepresentativeNationalCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- common -->
                    <TextBlock Text="اطلاعات تماس" Style="{StaticResource SectionTitle}" Margin="0,12,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="تلفن ثابت" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Owner.Phone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="تلفن همراه" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Owner.Mobile, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="کد پستی" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Owner.PostalCode, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="شغل / سمت" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Owner.JobTitle, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <TextBlock Text="آدرس محل سکونت (مالک حقیقی)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Owner.Address, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="آدرس محل فعالیت (مالک حقوقی)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Owner.WorkAddress, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Owner.Notes, UpdateSourceTrigger=PropertyChanged}"
                             Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="6" />
                </StackPanel>
            </Border>

            <!-- image -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="تصویر / لوگو" Style="{StaticResource SectionTitle}" />
                    <Border Width="160" Height="160" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Background="{DynamicResource GridHeaderBrush}" Padding="4">
                        <Image Source="{Binding Image}" Stretch="Uniform" />
                    </Border>
                    <Button Content="انتخاب تصویر" Command="{Binding PickImageCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                    <Button Content="حذف تصویر" Command="{Binding ClearImageCommand}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="ذخیره" Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}" MinWidth="110" />
            <Button Content="انصراف" Command="{Binding CancelCommand}" MinWidth="110" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
