<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CarForm.Views.Dialogs.VehicleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CarForm.Views"
        Title="{Binding Title}"
        Width="760" SizeToContent="Height"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <views:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- make / model -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                    <TextBlock Text="برند / سازنده" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Makes}" SelectedItem="{Binding SelectedMake}" DisplayMemberPath="Name" />
                    <TextBlock Text="{Binding [ModelId]}" Style="{StaticResource FieldError}"
                               Visibility="{Binding [ModelId], Converter={StaticResource EmptyToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="مدل" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="افزودن برند" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewMakeName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="افزودن" Command="{Binding AddMakeCommand}" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="افزودن مدل" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewModelName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="افزودن" Command="{Binding AddModelCommand}" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- specs -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="مشخصات خودرو" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="تیپ / کلاس" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.Trim, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="سال ساخت" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.ModelYear, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="رنگ" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.Color, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="شماره پلاک" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.PlateNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="VIN" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.Vin, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="شماره موتور" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.EngineNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="شماره شاسی" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.ChassisNumber, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="نوع سوخت" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.FuelType, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="نوع بدنه" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.BodyType, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="حجم موتور (cc)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.EngineDisplacement, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="کارکرد (کیلومتر)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.Mileage, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="سیستم" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.System, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="نوع کاربری" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.UsageType, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="تعداد سیلندر" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.Cylinders, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="تعداد محور" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.Axles, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="تعداد چرخ" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.Wheels, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="4" Margin="0,0,0,10">
                        <TextBlock Text="شماره اتاق" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.CabinNo, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="ظرفیت" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.Capacity, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="کشور سازنده" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Vehicle.Country, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="توضیحات" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Vehicle.Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="6" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="ذخیره" Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}" MinWidth="110" />
            <Button Content="انصراف" Command="{Binding CancelCommand}" MinWidth="110" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
