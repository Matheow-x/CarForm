<Window x:Class="CarForm.Views.Dialogs.PrintLayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CarForm.ViewModels"
        Title="{Binding Title}" Height="860" Width="1280" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="{DynamicResource WindowBackgroundBrush}" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- template + boxes -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="Stage" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="TemplateImage" Stretch="None" SnapsToDevicePixels="True" />
                    <Canvas x:Name="BoxLayer" Background="Transparent" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- side panel -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                         DisplayMemberPath="Field" />

                <StackPanel Grid.Row="1" Margin="0,12,0,0" DataContext="{Binding Selected}">
                    <TextBlock Text="موقعیت و اندازه (پیکسلِ تصویر قالب)" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="عرض" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding W, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="ارتفاع" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding H, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ضریب قلم" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FontScale, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="تراز" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Align, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Content="شکستن خط مجاز باشد"
                                  IsChecked="{Binding Wrap}" Margin="0,6,0,0" />
                    </Grid>
                    <TextBlock Text="راهنما: جعبه را بکشید، از گوشه‌ها تغییر اندازه دهید و با کلیدهای جهت‌نما (Shift = ۵ برابر) جابه‌جا کنید."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="0,12,0,0">
            <TextBlock Text="{Binding FilePath}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="ذخیره" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="بازنشانی" Command="{Binding ResetCommand}" Margin="8,0,0,0" />
            <Button Content="بستن" Click="CloseClick" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
