<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CarForm.Views.VehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarForm.Views"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardFlat}" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="خودرو جدید" Command="{Binding AddVehicleCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="ویرایش" Command="{Binding EditVehicleCommand}" Margin="8,0,0,0" />
                <Button Content="حذف" Command="{Binding DeleteVehicleCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0" />
                <Button Content="بروزرسانی" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
            </WrapPanel>
        </Border>

        <!-- three level browser -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2.2*" />
            </Grid.ColumnDefinitions>

            <!-- makes -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="برند / سازنده" Style="{StaticResource SectionTitle}" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding MakeSearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="جستجو" Command="{Binding SearchMakesCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" />
                    </Grid>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Makes}"
                             SelectedItem="{Binding SelectedMake}"
                             Style="{StaticResource PlainListBox}"
                             ItemContainerStyle="{StaticResource PlainListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="افزودن برند جدید" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewMakeName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="افزودن" Command="{Binding AddMakeCommand}" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- models -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}">
                        <Run Text="مدل‌ها" />
                        <Run Text="{Binding SelectedMake.Name, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>

                    <TextBlock Grid.Row="1" Text="ابتدا یک برند انتخاب کنید" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                               Visibility="{Binding SelectedMake, Converter={StaticResource NullToVisibility}, ConverterParameter=inverse}" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Models}"
                             SelectedItem="{Binding SelectedModel}"
                             Style="{StaticResource PlainListBox}"
                             ItemContainerStyle="{StaticResource PlainListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="0,8,0,0"
                                Visibility="{Binding SelectedMake, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Text="افزودن مدل جدید" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewModelName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding HasSelectedMake}" />
                            <Button Grid.Column="1" Content="افزودن" Command="{Binding AddModelCommand}" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- vehicles -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="خودروهای ثبت شده" Style="{StaticResource SectionTitle}" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding VehicleSearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="جستجو" Command="{Binding SearchVehiclesCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" />
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Vehicles}"
                              SelectedItem="{Binding SelectedVehicle}"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditVehicleCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="برند" Binding="{Binding MakeName}" Width="110" />
                            <DataGridTextColumn Header="مدل" Binding="{Binding ModelName}" Width="120" />
                            <DataGridTextColumn Header="تیپ" Binding="{Binding Trim}" Width="90" />
                            <DataGridTextColumn Header="سال" Binding="{Binding ModelYear}" Width="70" />
                            <DataGridTextColumn Header="رنگ" Binding="{Binding Color}" Width="100" />
                            <DataGridTextColumn Header="پلاک" Binding="{Binding PlateNumber}" Width="120" />
                            <DataGridTextColumn Header="VIN" Binding="{Binding Vin}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- selected vehicle details -->
        <Border Grid.Row="2" Style="{StaticResource CardFlat}" Margin="0,12,0,0"
                Visibility="{Binding SelectedVehicle, Converter={StaticResource NullToVisibility}}">
            <Grid DataContext="{Binding SelectedVehicle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="86" Height="86" CornerRadius="10" Margin="0,0,14,0"
                        Background="{DynamicResource GridHeaderBrush}">
                    <TextBlock Text="&#xE804;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">
                        <Run Text="{Binding MakeName, Mode=OneWay}" />
                        <Run Text=" " />
                        <Run Text="{Binding ModelName, Mode=OneWay}" />
                        <Run Text=" " />
                        <Run Text="{Binding Trim, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource TagBorder}" Margin="0,0,6,6">
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="سال: " /><Run Text="{Binding ModelYear, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource TagBorder}" Margin="0,0,6,6">
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="رنگ: " /><Run Text="{Binding Color, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource TagBorder}" Margin="0,0,6,6">
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="پلاک: " /><Run Text="{Binding PlateNumber, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource TagBorder}" Margin="0,0,6,6">
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="VIN: " /><Run Text="{Binding Vin, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource TagBorder}" Margin="0,0,6,6">
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="کارکرد: " /><Run Text="{Binding Mileage, Mode=OneWay, StringFormat=N0}" />
                            </TextBlock>
                        </Border>
                        <Border Style="{StaticResource TagBorder}" Margin="0,0,6,6">
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="موتور: " /><Run Text="{Binding EngineNumber, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
