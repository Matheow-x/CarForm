<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CarForm.Views.AppSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CarForm.Views"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <views:EnumDisplayConverter x:Key="EnumDisplay" />
        <views:FileSizeConverter x:Key="FileSize" />
        <views:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Backup -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="پشتیبان‌گیری و بازیابی" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="از پایگاه داده SQLite یک فایل کپی با نام شامل تاریخ و ساعت ایجاد می‌شود."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <WrapPanel>
                        <Button Content="تهیه نسخه پشتیبان" Command="{Binding BackupNowCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="پشتیبان در پوشه دلخواه" Command="{Binding BackupToFolderCommand}" Margin="8,0,0,0" />
                        <Button Content="بازیابی از فایل..." Command="{Binding RestoreCommand}" Margin="8,0,0,0" />
                    </WrapPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="مسیر پایگاه داده:" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DatabasePath}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" FontSize="12" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="حجم پایگاه داده:" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DatabaseSizeText}" Foreground="{DynamicResource TextBrush}" FontSize="12" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="پوشه داده‌ها:" Style="{StaticResource FieldLabel}" />
                        <WrapPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="{Binding AppDataPath}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontSize="12" />
                            <Button Content="باز کردن پوشه داده‌ها" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource GhostButton}" />
                            <Button Content="باز کردن پوشه پشتیبان‌ها" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource GhostButton}" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock Text="نسخه‌های پشتیبان موجود:" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <DataGrid ItemsSource="{Binding Backups}"
                              SelectedItem="{Binding SelectedBackup}"
                              Style="{StaticResource ModernDataGrid}"
                              Height="170">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenSelectedBackupCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام فایل" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="حجم" Binding="{Binding SizeBytes, Converter={StaticResource FileSize}}" Width="110" />
                            <DataGridTextColumn Header="تاریخ ایجاد" Binding="{Binding CreatedAtJalali}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="ظاهر برنامه" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="پوسته" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <CheckBox Content="نمایش اعداد با ارقام فارسی" IsChecked="{Binding UsePersianDigitsInUi}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Numbering -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="شماره‌گذاری خودکار اسناد" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الگوی شماره سند" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding NumberFormat, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding NumberFormatHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="آخرین شماره استفاده شده" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding LastNumber, Mode=OneWay}" IsEnabled="False" />
                            <TextBlock Text="{Binding NumberSample, StringFormat=نمونه شماره بعدی: {0}}"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <CheckBox Content="شماره‌گذاری خودکار پیش‌فرض" IsChecked="{Binding AutoNumbering}" />
                        </StackPanel>
                    </Grid>
                    <Button Content="ذخیره تنظیمات شماره‌گذاری" Command="{Binding SaveNumberingCommand}"
                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="داده‌ها و اطلاعات برنامه" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <Button Content="افزودن داده‌های نمونه" Command="{Binding SeedDemoDataCommand}" />
                    </WrapPanel>
                    <TextBlock Text="داده‌های نمونه شامل دو مالک و یک خودرو است تا امکان تست جستجو و صدور سند فراهم شود."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
