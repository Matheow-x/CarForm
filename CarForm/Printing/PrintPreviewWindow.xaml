<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="CarForm.Printing.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پیش‌نمایش چاپ"
        Height="900" Width="1000"
        MinHeight="600" MinWidth="760"
        FlowDirection="LeftToRight"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="پیش‌نمایش سند - خروجی PDF دقیقاً مطابق این صفحه است"
                           Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="چاپ" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="خروجی PDF" Command="{Binding ExportPdfCommand}" Margin="8,0,0,0" />
                    <Button Content="بستن" Command="{Binding CloseCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <DocumentViewer Grid.Row="1" Document="{Binding Document}" Background="#FF9E9E9E" />
    </Grid>
</Window>
