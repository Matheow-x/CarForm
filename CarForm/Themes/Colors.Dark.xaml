<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AppBackgroundColor">#111827</Color>
    <Color x:Key="SidebarColor">#0B1220</Color>
    <Color x:Key="SidebarTextColor">#C7D2E0</Color>
    <Color x:Key="CardColor">#1B2536</Color>
    <Color x:Key="TextColor">#E5EAF2</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>
    <Color x:Key="BorderColor">#2C3A50</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#60A5FA</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="InputBackgroundColor">#16202F</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>
    <Color x:Key="GridHeaderColor">#223049</Color>
    <Color x:Key="GridAltRowColor">#182231</Color>
    <Color x:Key="SelectionColor">#3B82F6</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{DynamicResource SidebarTextColor}" />
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{DynamicResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="{DynamicResource GridHeaderColor}" />
    <SolidColorBrush x:Key="GridAltRowBrush" Color="{DynamicResource GridAltRowColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />

</ResourceDictionary>
